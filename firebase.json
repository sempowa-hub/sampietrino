{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      ".venv/**",
      "strumenti/**",
      "test/**",
      "docs/**",
      "dati/fonti/**",
      "dati/*.csv",
      "dati/categorie.json",
      "dati/notorieta.json",
      "dati/correzioni-fasce.json",
      "README.md",
      "package.json",
      "package-lock.json",
      "img/*anteprima*",
      "firestore.rules",
      "firestore.indexes.json",
      "dati/domande-generate.json",
      "dati/domande-scartate.json",
      "dati/domande-proposte.json",
      "dati/domande-approvate.json",
      "dati/proposte-follower.json",
      "dati/calendario.json"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "font/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}

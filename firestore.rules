rules_version = '2';

// Sampietrino: ognuno scrive solo il suo profilo e il suo punteggio del giorno.
// I punteggi si leggono da tutti (classifica); il totale deve tornare con le fasce tappa per tappa.
service cloud.firestore {
  match /databases/{database}/documents {

    function mio(uid) { return request.auth != null && request.auth.uid == uid; }
    // Amministratori (Simone, Themino): un documento admin/{uid} creato a mano dalla console. Niente email nel codice.
    function admin() { return request.auth != null && exists(/databases/$(database)/documents/admin/$(request.auth.uid)); }
    function conGoogle() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function testo(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function due(n) { return (n < 10 ? '0' : '') + string(n); }
    function giorno(t) { return string(t.year()) + '-' + due(t.month()) + '-' + due(t.day()); }
    // Oggi a Roma cade tra ieri e domani in UTC.
    function vicino(data) {
      return data in [giorno(request.time), giorno(request.time - duration.value(1, 'd')), giorno(request.time + duration.value(1, 'd'))];
    }
    // Punti per fascia: buca (-1) 0, Da cartolina 1, Ce sta 2, Da romano 3, Chicca 5, Da Mino 8.
    function punti(l) { return [0, 1, 2, 3, 5, 8][l + 1]; }
    function livello(l) { return l == null || (l is int && l >= -1 && l <= 4); }
    function nomeOk(d) { return d.nome is string && d.nome.size() <= 20 && d.foto is string && d.foto.size() <= 500 && d.pubblico is bool; }

    match /giocatori/{uid} {
      allow read, write: if mio(uid);
    }

    // Contatore delle partite (anche anonime): ogni scrittura aggiunge 1 a un campo solo, nel giorno di oggi a Roma.
    function piuUno(k) { return request.resource.data[k] == resource.data.get(k, 0) + 1; }
    match /contatori/{data} {
      allow read: if admin();
      allow create: if request.auth != null && vicino(data)
        && request.resource.data.keys().hasOnly(['iniziate', 'finite', 'arretrati']) && request.resource.data.size() == 1
        && request.resource.data.values().hasOnly([1]);
      allow update: if request.auth != null && vicino(data) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['iniziate']) && piuUno('iniziate'))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finite']) && piuUno('finite'))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['arretrati']) && piuUno('arretrati')));
    }

    match /admin/{uid} {
      allow read: if mio(uid);
    }

    // Chicche proposte dai follower: le scrive chi e entrato con Google, le leggono lui e gli amministratori,
    // le approvano o scartano solo gli amministratori.
    match /proposte/{id} {
      allow create: if conGoogle() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'luogo', 'zona', 'perche', 'domanda', 'quando', 'stato'])
        && testo(request.resource.data.nome, 1, 20) && testo(request.resource.data.luogo, 3, 80) && testo(request.resource.data.zona, 2, 60)
        && testo(request.resource.data.perche, 20, 500) && testo(request.resource.data.domanda, 0, 120)
        && request.resource.data.stato == 'nuova' && request.resource.data.quando == request.time;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || admin());
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'nota', 'decisa'])
        && request.resource.data.stato in ['approvata', 'scartata', 'nuova'] && testo(request.resource.data.get('nota', ''), 0, 300);
    }

    // Punteggio del giorno: 5 fasce valide e il totale che torna con le fasce.
    function punteggioOk(d) {
      return d.livelli is list && d.livelli.size() == 5
        && livello(d.livelli[0]) && livello(d.livelli[1]) && livello(d.livelli[2]) && livello(d.livelli[3]) && livello(d.livelli[4])
        && d.tot == punti(d.livelli[0]) + punti(d.livelli[1]) + punti(d.livelli[2]) + punti(d.livelli[3]) + punti(d.livelli[4]);
    }
    match /partite/{data}/punteggi/{uid} {
      allow read: if true;
      allow create: if mio(uid) && conGoogle() && vicino(data)
        && request.resource.data.keys().hasOnly(['tot', 'livelli', 'ora', 'pubblico', 'nome', 'foto'])
        && punteggioOk(request.resource.data)
        && request.resource.data.ora == request.time
        && nomeOk(request.resource.data);
      allow update: if mio(uid) && (
        // Dopo il login si aggiungono nome e foto.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pubblico', 'nome', 'foto'])
          && nomeOk(request.resource.data))
        // Domande corrette a giornata in corso: il telefono ricalcola le fasce e aggiorna il punteggio, con gli
        // stessi controlli della creazione. L'ora resta quella della prima partita.
        || (conGoogle() && vicino(data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tot', 'livelli', 'pubblico', 'nome', 'foto'])
          && punteggioOk(request.resource.data)
          && nomeOk(request.resource.data)));
    }

    // Settimana (da lunedi): la somma dei punteggi del giorno. Ogni giorno si aggiunge una volta sola (poi si puo solo
    // correggere) e deve valere esattamente quanto il punteggio di quel giorno gia salvato in partite/{data}/punteggi/{uid}.
    function delGiorno(d, uid) { return get(/databases/$(database)/documents/partite/$(d)/punteggi/$(uid)).data.tot; }
    function settimanaOk(d, settimana) { return d >= settimana && vicino(d); }
    match /settimane/{settimana}/punteggi/{uid} {
      allow read: if true;
      allow create: if mio(uid) && conGoogle()
        && request.resource.data.keys().hasOnly(['tot', 'giorni', 'n', 'ultimo', 'ora', 'pubblico', 'nome', 'foto'])
        && settimanaOk(request.resource.data.ultimo, settimana)
        && request.resource.data.giorni.keys().hasOnly([request.resource.data.ultimo])
        && request.resource.data.giorni[request.resource.data.ultimo] == delGiorno(request.resource.data.ultimo, uid)
        && request.resource.data.tot == request.resource.data.giorni[request.resource.data.ultimo]
        && request.resource.data.n == 1 && request.resource.data.ora == request.time
        && nomeOk(request.resource.data);
      allow update: if mio(uid) && conGoogle() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pubblico', 'nome', 'foto']) && nomeOk(request.resource.data))
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tot', 'giorni', 'n', 'ultimo', 'ora', 'pubblico', 'nome', 'foto'])
          && settimanaOk(request.resource.data.ultimo, settimana)
          && !(request.resource.data.ultimo in resource.data.giorni)
          && request.resource.data.giorni.diff(resource.data.giorni).affectedKeys().hasOnly([request.resource.data.ultimo])
          && request.resource.data.giorni[request.resource.data.ultimo] == delGiorno(request.resource.data.ultimo, uid)
          && request.resource.data.tot == resource.data.tot + request.resource.data.giorni[request.resource.data.ultimo]
          && request.resource.data.n == resource.data.n + 1 && request.resource.data.ora == request.time
          && nomeOk(request.resource.data)
        )
        // Correzione di un giorno gia nella settimana (domande corrette): "corretto" dice quale, deve valere quanto
        // il punteggio del giorno e il totale cambia della differenza. Numero di partite, ultimo giorno e ora restano.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tot', 'giorni', 'corretto'])
          && settimanaOk(request.resource.data.corretto, settimana)
          && request.resource.data.corretto in resource.data.giorni
          && request.resource.data.giorni.diff(resource.data.giorni).affectedKeys().hasOnly([request.resource.data.corretto])
          && request.resource.data.giorni[request.resource.data.corretto] == delGiorno(request.resource.data.corretto, uid)
          && request.resource.data.tot == resource.data.tot - resource.data.giorni[request.resource.data.corretto]
            + request.resource.data.giorni[request.resource.data.corretto]
        ));
    }
  }
}
